{
  "name": "boydaksu/colezahost",
  "description": "Coleza Host — Hosting Commerce & Operations Platform",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Coleza\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Coleza\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
